```astro
---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getVisibleCompanies } from '../lib/content';

const companies = getVisibleCompanies();
---

<SiteLayout
  title="Nordic Systems | Source-backed architecture maps"
  description="Original, provenance-aware architecture maps of Nordic technology companies."
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">

    <!-- Hero -->
    <div class="max-w-3xl">
      <p class="text-sm font-semibold tracking-wide text-slate-700">
        Nordic Systems
      </p>

      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
        Architecture maps that show what is documented, inferred, and unknown.
      </h1>

      <p class="mt-5 text-lg leading-8 text-slate-700">
        We reconstruct software architecture from public evidence, keeping
        facts, interpretation, and speculation visibly distinct.
      </p>
    </div>

    <!-- Provenance -->
    <section
      class="mt-12 max-w-4xl"
      aria-labelledby="provenance-heading"
    >
      <h2
        id="provenance-heading"
        class="text-2xl font-semibold text-slate-900"
      >
        Provenance first
      </h2>

      <dl class="mt-5 grid gap-4 sm:grid-cols-3">

        <div class="rounded-lg border border-slate-200 bg-white p-5">
          <dt class="font-semibold text-slate-900">
            Documented
          </dt>

          <dd class="mt-2 text-sm leading-6 text-slate-600">
            Supported by one or more public sources.
          </dd>
        </div>

        <div class="rounded-lg border border-slate-200 bg-white p-5">
          <dt class="font-semibold text-slate-900">
            Inferred
          </dt>

          <dd class="mt-2 text-sm leading-6 text-slate-600">
            A reasoned interpretation with its rationale stated.
          </dd>
        </div>

        <div class="rounded-lg border border-slate-200 bg-white p-5">
          <dt class="font-semibold text-slate-900">
            Speculative
          </dt>

          <dd class="mt-2 text-sm leading-6 text-slate-600">
            A clearly marked possibility, not a fact.
          </dd>
        </div>

      </dl>
    </section>

    <!-- Companies -->
    <section
      class="mt-14"
      aria-labelledby="companies-heading"
    >
      <div class="flex items-end justify-between gap-4">

        <div>
          <h2
            id="companies-heading"
            class="text-2xl font-semibold text-slate-900"
          >
            Companies
          </h2>

          <p class="mt-2 text-sm text-slate-600">
            Explore architecture maps and their supporting sources.
          </p>
        </div>

        {companies.length > 0 && (
          <p class="text-sm text-slate-500">
            {companies.length} companies
          </p>
        )}

      </div>

      {companies.length ? (
        <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

          {companies.map((company) => (
            <li
              class="group flex min-h-[220px] flex-col rounded-xl border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-1 hover:border-slate-300 hover:shadow-md"
            >

              <!-- Logo -->
              <div class="flex h-12 w-12 items-center justify-center rounded-lg border border-slate-200 bg-white">
                {company.logo ? (
                  <img
                    src={company.logo}
                    alt={`${company.displayName} logo`}
                    class="h-8 w-8 object-contain"
                    loading="lazy"
                  />
                ) : (
                  <span
                    class="text-sm font-semibold text-slate-400"
                    aria-hidden="true"
                  >
                    {company.displayName.charAt(0)}
                  </span>
                )}
              </div>

              <!-- Company information -->
              <div class="mt-5 flex-1">

                <h3 class="font-semibold text-slate-900">
                  {company.displayName}
                </h3>

                <p class="mt-2 text-sm leading-6 text-slate-600">
                  {company.shortDescription}
                </p>

              </div>

              <!-- Links -->
              <div class="mt-6 flex items-center gap-4 text-sm">

                <a
                  class="font-medium text-slate-900 underline underline-offset-4 transition hover:text-slate-500"
                  href={`/diagram/${company.slug}`}
                >
                  Diagram
                </a>

                <a
                  class="font-medium text-slate-900 underline underline-offset-4 transition hover:text-slate-500"
                  href={`/sources/${company.slug}`}
                >
                  Sources
                </a>

              </div>

            </li>
          ))}

        </ul>
      ) : (
        <div class="mt-6 rounded-xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center">
          <p class="text-slate-700">
            Our first company is coming soon.
          </p>
        </div>
      )}

    </section>

  </section>
</SiteLayout>