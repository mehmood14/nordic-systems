---
import ArchitectureDiagram from '../../components/ArchitectureDiagram';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCompanyDiagram, getVisibleCompanies } from '../../lib/content';

export function getStaticPaths() { return getVisibleCompanies().map((company) => ({ params: { company: company.slug } })); }
const { company: companySlug } = Astro.params;
const graph = companySlug ? await getCompanyDiagram(companySlug) : undefined;
if (!graph) return Astro.redirect('/');
const company = getVisibleCompanies().find((entry) => entry.slug === graph.company);
const displayName = company?.displayName ?? graph.company;
---
<SiteLayout title={`${displayName} architecture diagram | Nordic Systems`} description={`A provenance-aware architecture reconstruction for ${displayName}.`}>
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8"><header class="mb-6 max-w-3xl"><p class="text-sm font-semibold tracking-wide text-slate-700">Nordic Systems</p><h1 class="mt-2 text-3xl font-semibold tracking-tight">{displayName} architecture</h1><p class="mt-3 text-slate-700">Line styles show the weakest provenance status attached to each component or flow. This page distinguishes documented facts from inference and speculation.</p><a class="mt-3 inline-block underline" href={`/sources/${graph.company}`}>View source library</a></header><ArchitectureDiagram client:only="react" graph={graph} /></section>
</SiteLayout>
