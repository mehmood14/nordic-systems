---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCompanySourceLibrary, getVisibleCompanies } from '../../lib/content';

export function getStaticPaths() {
  return getVisibleCompanies().map((company) => ({ params: { company: company.slug } }));
}

const { company } = Astro.params;
const sources = company ? await getCompanySourceLibrary(company) : undefined;
if (!sources) return Astro.redirect('/');
---
<SiteLayout title={`${company} sources | Nordic Systems`} description={`Public sources cited in the ${company} architecture reconstruction.`}>
  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8"><p><a class="underline" href={`/diagram/${company}`}>Back to diagram</a></p><h1 class="mt-5 text-3xl font-semibold">{company} source library</h1>{sources.length ? <ul class="mt-8 space-y-5">{sources.map((source) => <li class="rounded border border-slate-200 bg-white p-5"><h2 class="font-semibold"><a class="underline" href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a></h2><p class="mt-2 text-sm text-slate-700">{source.type} · {source.publishedAt}{source.author ? ` · ${source.author}` : ''}</p>{source.archivedUrl && <p class="mt-2 text-sm"><a class="underline" href={source.archivedUrl} target="_blank" rel="noopener noreferrer">Archived link</a></p>}<p class="mt-3 text-sm text-slate-700">Cited by: {source.components.length ? source.components.map((component) => component.name).join(', ') : 'No components yet.'}</p></li>)}</ul> : <p class="mt-4 text-slate-700">No public sources have been added yet.</p>}</section>
</SiteLayout>
