---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCompanySourceLibrary, getVisibleCompanies } from '../../lib/content';

export function getStaticPaths() {
  return getVisibleCompanies().map((company) => ({ params: { company: company.slug } }));
}

const { company } = Astro.params;
const sources = company ? await getCompanySourceLibrary(company) : undefined;
if (!sources) return Astro.redirect('/');
const companyName = getVisibleCompanies().find((entry) => entry.slug === company)?.displayName ?? company;
---
<SiteLayout title={`${company} sources | Nordic Systems`} description={`Public sources cited in the ${company} architecture reconstruction.`}>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <nav aria-label="Breadcrumb" class="mb-10">
      <a
        class="text-sm font-medium text-slate-700 underline decoration-slate-300 underline-offset-4 transition-colors hover:decoration-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-700"
        href={`/diagram/${company}`}
      >
        Back to {companyName} diagram
      </a>
    </nav>

    <header class="page-intro flex flex-wrap items-end justify-between gap-x-8 gap-y-5">
      <div class="max-w-3xl">
        <p class="page-kicker">Source library · {companyName}</p>
        <h1 class="mt-4 text-4xl font-semibold leading-[1.08] tracking-tight text-slate-900 sm:text-5xl">
          The evidence behind the map.
        </h1>
        <p class="page-lead mt-5">
          Public material cited by claims in the {companyName} architecture reconstruction.
        </p>
      </div>
      <p class="pb-1 text-sm text-slate-500">
        {sources.length} {sources.length === 1 ? 'source' : 'sources'}
      </p>
    </header>

    {sources.length ? (
      <ul class="source-list mt-14">
        {sources.map((source) => (
          <li class="source-item">
            <p class="source-item__date">{source.publishedAt}</p>
            <div class="min-w-0">
              <p class="source-item__type">
                {source.type.replace(/-/g, ' ')}{source.author ? ` · ${source.author}` : ''}
              </p>
              <h2 class="mt-2">
                <a
                  class="source-item__title focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-700"
                  href={source.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {source.title}
                </a>
              </h2>
              <p class="source-item__cited">
                <span class="font-semibold">Cited by:</span>{' '}
                {source.components.length ? source.components.map((component) => component.name).join(', ') : 'No components yet.'}
              </p>
              {source.archivedUrl && (
                <a class="source-item__archive" href={source.archivedUrl} target="_blank" rel="noopener noreferrer">
                  Archived link
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-14 border-t border-slate-200 py-6 text-slate-700">No public sources have been added yet.</p>
    )}
  </section>
</SiteLayout>
