---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found | Nordic Systems" description="The requested Nordic Systems page could not be found.">
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <div class="error-layout">
      <div>
        <p class="page-kicker">404 · Page not found</p>
        <h1 class="mt-4 max-w-xl text-4xl font-semibold leading-[1.08] tracking-tight text-slate-900 sm:text-5xl">
          This page isn’t here.
        </h1>
        <p class="page-lead mt-5">
          The address may be out of date, or the page may have moved.
        </p>
        <a
          class="mt-8 inline-flex min-h-11 items-center justify-center rounded-md bg-slate-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-700"
          href="/"
        >
          Return to Nordic Systems
        </a>
      </div>
      <div class="error-mark" aria-hidden="true">
        404
        <span class="error-mark__rule"></span>
      </div>
    </div>
  </section>
</SiteLayout>
